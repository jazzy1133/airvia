<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.opus.airvia"
    android:versionCode="16"
    android:versionName="1.3.5">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ package visibility (1.3.5): without this, the
         Tune tab's per-app capture list (a MAIN/LAUNCHER
         queryIntentActivities call) only sees a handful of system
         apps. Declares visibility for launcher apps only —
         deliberately NOT the QUERY_ALL_PACKAGES permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="Airvia"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.opus.airvia.cast.AirviaCastOptionsProvider" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Speaker picker sheet. Opened by the notification's
             Speakers action (our own PendingIntent) and by a
             LONG-PRESS on the Quick Settings tile: the system
             launches the activity holding QS_TILE_PREFERENCES
             (TileService API). exported=true is required for the
             system surface; the BIND_QUICK_SETTINGS_TILE permission
             (signature|privileged, held by SystemUI) keeps third-party
             apps from opening it directly — same-UID callers (the
             notification/service) pass the component check. -->
        <activity
            android:name=".PickerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".AutomationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.opus.airvia.action.CAST_SPEAKER" />
                <action android:name="com.opus.airvia.action.STOP_CAST" />
                <action android:name="com.opus.airvia.action.SET_VOLUME" />
                <action android:name="com.opus.airvia.action.STEP_VOLUME" />
            </intent-filter>
        </receiver>
        <service
            android:name=".CastService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service
            android:name=".CastTileService"
            android:exported="true"
            android:icon="@drawable/ic_speaker"
            android:label="Airvia Cast"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".NowPlayingListenerService"
            android:exported="true"
            android:label="Airvia now playing"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
